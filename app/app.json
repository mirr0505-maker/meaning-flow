{
  "expo": {
    "name": "Meaning Flow",
    "slug": "meaning-flow",
    "scheme": "meaningflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF8F1"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mirr.meaningflow",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FBF8F1"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.mirr.meaningflow"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-localization",
      "expo-web-browser",
      "@sentry/react-native"
    ],
    "extra": {
      "eas": {
        "projectId": "99e22e91-76e8-450d-ba79-5764f4a7be91"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "mirr0505",
    "updates": {
      "url": "https://u.expo.dev/99e22e91-76e8-450d-ba79-5764f4a7be91"
    }
  }
}
