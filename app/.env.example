# Meaning Flow — env template (committed)
# 실제 값은 .env (gitignored) 에 채운다. 이 파일은 키 자리만 보여주는 참고용.

# Supabase Dashboard → ⚙ Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Phase 4 — Sentry (오류 추적, 사용자 consent ON 일 때만 init)
# https://sentry.io → React Native 프로젝트 생성 → DSN 복사
EXPO_PUBLIC_SENTRY_DSN=

# Phase 4 — PostHog (사용 분석, M1: 사용자 노출 X / M6: 본문 X)
# https://app.posthog.com → 프로젝트 → API Key
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
